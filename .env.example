# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit a real key.

# Required for live scanning and recipe generation.
# Without it Kairos still runs, but /api/vision and /api/recipe return
# canned demo data and the kitchen shows a "Demo mode" notice.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Signs the passkey session cookie (HMAC-SHA256).
# Optional in development: if unset, a random secret is generated into
# .data/credentials.json, which means sessions drop whenever that file is
# reset and every server instance signs with a different secret.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
