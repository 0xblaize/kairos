# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit a real key.

# Required for live scanning and recipe generation.
# Without it Kairos still runs, but /api/vision and /api/recipe return
# canned demo data and the kitchen shows a "Demo mode" notice.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Signs the passkey session cookie (HMAC-SHA256). Required.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres connection string, used to store passkeys and login challenges.
# Serverless hosts have a read-only filesystem and don't share memory between
# instances, so this cannot be a local file.
# On Vercel: Storage tab -> create a Postgres/Neon database and it is injected
# automatically. Locally: copy the connection string from your provider.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
